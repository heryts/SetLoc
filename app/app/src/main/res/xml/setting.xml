<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/preference_category_general">

        <rikka.preference.SimpleMenuPreference
            android:defaultValue="-1"
            android:entries="@array/theme_texts"
            android:entryValues="@array/theme_values"
            android:icon="@drawable/ic_dark_mode"
            android:key="darkTheme"
            android:summary="%s"
            android:title="@string/dark_theme" />

        <rikka.preference.SimpleMenuPreference
            android:title="Map"
            android:summary="%s"
            android:icon="@drawable/ic_map_type"
            android:key="map_type"
            android:dialogTitle="Map type"
            android:entries="@array/map_type"
            android:entryValues="@array/map_value"
            android:defaultValue="1"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_location">

        <EditTextPreference
            android:defaultValue="10"
            android:digits="0123456789"
            android:key="accuracy_settings"
            android:title="@string/settings_of_accuracy"
            android:icon="@drawable/ic_accuracy"
            android:summary="10 m."/>

        <SwitchPreference
            android:title="Random position"
            android:summary="Location position will be random around set location"
            android:icon="@drawable/ic_random_position"
            android:defaultValue="true"
            android:key="random_position"/>

        <EditTextPreference
            android:title="@string/settings_random_radius"
            android:dependency="random_position"
            android:key="random_radius"/>

        <SwitchPreference
            android:title="@string/settings_altitude_server"
            android:summary="@string/settings_altitude_server_summary"
            android:defaultValue="true"
            android:key="altitude_from_server"/>

        <EditTextPreference
            android:title="@string/settings_altitude"
            android:key="altitude_manual"/>

        <EditTextPreference
            android:title="@string/settings_altitude_var"
            android:key="altitude_var"/>

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_route">

        <SwitchPreference
            android:title="@string/settings_traffic_aware"
            android:summary="@string/settings_traffic_aware_summary"
            android:defaultValue="true"
            android:key="route_traffic_aware"/>

    </PreferenceCategory>

</PreferenceScreen>